# 环境监测方案管理系统 - 后端环境变量
# 复制为 .env 后填写

# 本地开发默认 SQLite（相对 backend 上级 data/detection.db）
# DATABASE_URL=sqlite:////absolute/path/to/data/detection.db

# 生产 SQL Server 新建库 detection 示例：
# DATABASE_URL=mssql+pyodbc://sa:YourPassword@127.0.0.1/detection?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# LLM（dsv4f 测试）— OpenAI 兼容接口
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=dsv4f
LLM_TIMEOUT=120
LLM_MAX_INPUT_CHARS=60000

DEBUG=true
