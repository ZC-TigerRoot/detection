# 复制为 backend/.env 后填写（不要提交 .env）

# ---------- 数据库 ----------
# 开发（本机 SQLite）:
# DATABASE_URL=sqlite:///C:/detection/data/detection.db

# 生产 SQL Server 新建库 detection（Docker 容器连宿主机用 host.docker.internal）:
# 密码含特殊字符时请 URL 编码，例如 @ -> %40  : -> %3A  / -> %2F
# 中文必须用 NVARCHAR（模型已配置；旧库启动时会自动迁移）。若界面全是 ????，升级后重启 API 并重新解析项目。
DATABASE_URL=mssql+pyodbc://sa:YourPassword@host.docker.internal/detection?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# 本机不跑 Docker、直接装 Python 时用:
# DATABASE_URL=mssql+pyodbc://sa:YourPassword@127.0.0.1/detection?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ---------- LLM（dsv4f / OpenAI 兼容）----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=dsv4f
LLM_TIMEOUT=120
LLM_MAX_INPUT_CHARS=60000

# ---------- 其它 ----------
DEBUG=false
# UPLOAD_DIR / EXPORT_DIR 在 Docker 中由 compose 注入，本机原生部署可不填
